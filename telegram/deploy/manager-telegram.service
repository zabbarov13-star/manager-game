[Unit]
Description=Manager Telegram adapter (no game rooms)
After=network.target

[Service]
Type=simple
User=manager-telegram
Group=manager-telegram
WorkingDirectory=/opt/manager-telegram/current
EnvironmentFile=/etc/manager-telegram/adapter.env
Environment=TELEGRAM_MODE=adapter BIND=127.0.0.1 PORT=8443 COSMETIC_RPC_PORT=8444 TELEGRAM_DATABASE=/var/lib/manager-telegram/telegram.sqlite STARS_ENABLED=0 ADS_VERIFIED_GATEWAY_ENABLED=0
ExecStart=/opt/manager-node/bin/node telegram/server.cjs
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manager-telegram
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
