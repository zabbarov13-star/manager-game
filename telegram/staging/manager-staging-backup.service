[Unit]
Description=Verified SQLite snapshots for isolated Manager staging
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Set these to the dedicated staging checkout and its operator before installation.
User=manager-staging
WorkingDirectory=/srv/manager-telegram-staging
UMask=0077
ExecStart=/usr/bin/docker compose --env-file telegram/.env -f telegram/staging/compose.yaml exec -T app node /app/telegram/backup-set.cjs snapshot /data /backups
TimeoutStartSec=600
