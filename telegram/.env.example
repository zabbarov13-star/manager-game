TELEGRAM_BOT_TOKEN=
TELEGRAM_ENV=production
STARS_ENABLED=0
OWNER_TELEGRAM_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_ORIGIN=https://manager-telegram.example.org
SUPPORT_CONTACT=
TELEGRAM_DATABASE=./data/telegram.sqlite
PORT=8090
BIND=127.0.0.1
ADSGRAM_BLOCK_ID=1788
# Keep OFF until a trusted provider verification gateway is implemented and audited.
# Reward Unit 1788 (platform 58198); SDK blockId is a string, not platform/Bot ID.
# Native AdsGram userId-only Reward URL is NOT sufficient to enable this.
ADS_VERIFIED_GATEWAY_ENABLED=0
ADS_RECEIPT_SECRET=
# Shared VPS uses the native service template and a separate protected RPC key.
# standalone remains available for dedicated staging/tests only.
TELEGRAM_MODE=standalone
COSMETIC_RPC_SECRET=
COSMETIC_RPC_PORT=8444
