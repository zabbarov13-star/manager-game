{
  "name": "manager-back-to-the-past-preview",
  "version": "0.19.1-preview.3",
  "description": "Менеджер — Назад в прошлое",
  "author": "Manager project",
  "main": "main.cjs",
  "private": true,
  "devDependencies": {
    "electron": "42.0.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "ru.manager.backtothepast.preview",
    "productName": "Manager",
    "artifactName": "Manager-${os}-${arch}.${ext}",
    "files": ["main.cjs", "game/**", "package.json"],
    "directories": {"output": "out", "buildResources": "game"},
    "win": {"target": ["nsis", "zip"], "icon": "game/manager-icon.png"},
    "mac": {"target": ["dmg"], "identity": null, "icon": "game/manager-icon.png"},
    "nsis": {"oneClick": false, "perMachine": false}
  }
}
